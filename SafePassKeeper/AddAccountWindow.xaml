<Window x:Class="SafePassKeeper.AddAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modify Datacore" Height="680" Width="450"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource VoidBlack}"
        FontFamily="Inter, Segoe UI, sans-serif" Icon="/icon.ico">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SensorMuted}"/>
            <Setter Property="FontFamily" Value="Rajdhani, Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,15,0,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource StationGray}" BorderBrush="{StaticResource GridSteel}" BorderThickness="0,0,0,1" Padding="20,15">
            <TextBlock Text="DATA INJECTION PROTOCOL" Foreground="{StaticResource StarlightWhite}" FontSize="18" FontWeight="Bold" Margin="0" HorizontalAlignment="Center"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <StackPanel Margin="30,10,30,30">

                <TextBlock Text="// ACCOUNT_NAME"/>
                <TextBox x:Name="AccountNameTextBox"/>

                <TextBlock Text="// USER_CREDENTIAL"/>
                <TextBox x:Name="UsernameTextBox"/>

                <TextBlock Text="// ENCRYPTED_KEY"/>
                <PasswordBox x:Name="PasswordBox"/>

                <TextBlock Text="// TARGET_URL"/>
                <TextBox x:Name="DomainTextBox"/>

                <TextBlock Text="// ATTACHED_NOTES"/>
                <TextBox x:Name="NoteTextBox" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,0">
                    <Button Content="[ ABORT ]" Click="CancelButton_Click" Style="{StaticResource TechGhostButton}" Margin="0,0,10,0"/>
                    <Button Content="[ INJECT DATA ]" Click="OkButton_Click" Style="{StaticResource TechGhostButton}" Foreground="{StaticResource ShieldGreen}">
                        <Button.Effect>
                            <!-- ZDE JE OPRAVA BARVY NA #00FF66 -->
                            <DropShadowEffect Color="#00FF66" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>