<Window x:Class="SafePassKeeper.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Security Override" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource VoidBlack}"
        FontFamily="Inter, Segoe UI, sans-serif" Icon="/icon.ico">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- Opravený počet řádků pro správné zarovnání -->
        </Grid.RowDefinitions>

        <!-- Přidán x:Name="TitleText" a x:Name="TitleGlow" pro dynamickou změnu barvy z C# -->
        <TextBlock x:Name="TitleText" Text="SECURITY LOCK ACTIVE" Foreground="{StaticResource HullOrange}" FontFamily="Rajdhani, Orbitron, Arial" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,10">
            <TextBlock.Effect>
                <!-- Opravena barva stínu na HEX hodnotu proti padání aplikace -->
                <DropShadowEffect x:Name="TitleGlow" Color="#FF3300" BlurRadius="15" ShadowDepth="0" Opacity="0.8"/>
            </TextBlock.Effect>
        </TextBlock>

        <!-- Přidán x:Name="SubtitleText" -->
        <TextBlock x:Name="SubtitleText" Grid.Row="1" Text="// AWAITING DECRYPTION KEY_VERIFICATION" Foreground="{StaticResource SensorMuted}" FontFamily="Rajdhani, Consolas" FontSize="12" Margin="0,15,0,5" HorizontalAlignment="Center"/>

        <PasswordBox x:Name="PasswordBox" Grid.Row="2" Margin="0,0,0,25" HorizontalContentAlignment="Center"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="[ CANCEL ]" Click="CancelButton_Click" Style="{StaticResource TechGhostButton}" Margin="0,0,15,0" Width="120"/>

            <!-- Přidán x:Name="ActionBtn" pro změnu textu/barvy u nového souboru -->
            <Button x:Name="ActionBtn" Content="[ OVERRIDE ]" Click="OkButton_Click" Style="{StaticResource TechGhostButton}" Foreground="{StaticResource TritaniumCyan}" Width="120"/>
        </StackPanel>
    </Grid>
</Window>